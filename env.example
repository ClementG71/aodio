# Clé secrète Flask
SECRET_KEY=your-secret-key-here

# Configuration Flask
# Désactiver en production (False par défaut)
FLASK_DEBUG=False
# Port sur lequel l'application écoute (défaut: 121)
# Peut être changé selon les ports ouverts sur votre VPS
PORT=121
# Domaines autorisés pour CORS (séparés par virgule, ex: https://example.com,https://app.example.com)
# Si vide, tous les domaines sont autorisés (non recommandé en production)
ALLOWED_ORIGINS=

# Mistral AI (transcription + LLM)
MISTRAL_API_KEY=your-mistral-api-key

# Mode Voxtral-only (optionnel)
# Si true : transcription + diarisation via Voxtral Mini Transcribe V2 uniquement (pas de RunPod)
USE_VOXTRAL_ONLY=false

# RunPod (requis seulement si USE_VOXTRAL_ONLY=false)
RUNPOD_API_KEY=your-runpod-api-key
RUNPOD_ENDPOINT_ID=your-runpod-endpoint-id

# Configuration Dokploy (optionnel)
# Définir à "true" pour activer la configuration Dokploy
DOKPLOY_ENV=false
# Domaine public pour Dokploy (utilisé pour générer les URLs publiques)
DOKPLOY_PUBLIC_DOMAIN=https://your-dokploy-domain.com

