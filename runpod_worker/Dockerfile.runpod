# Dockerfile pour RunPod Worker - situé dans runpod_worker/
# Utilisation de PyTorch 2.6.0 qui inclut Python 3.10+ requis par Pyannote 4.0.1
# Cette image contient CUDA 12.6, compatible avec la plupart des GPU RunPod
FROM pytorch/pytorch:2.6.0-cuda12.6-cudnn9-runtime

# Installer les dépendances système (cette couche sera mise en cache)
RUN apt-get update && apt-get install -y \
    ffmpeg \
    libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

# Créer le répertoire de travail
WORKDIR /app

# Copier uniquement requirements.txt d'abord (pour maximiser le cache)
COPY runpod_worker/requirements.txt ./requirements.txt

# Installer les dépendances Python
# Note: pyannote.audio 4.0.1 nécessite torch >= 2.6.0 et python >= 3.10
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt

# Copier le handler en dernier (change le plus souvent)
COPY runpod_worker/handler.py ./handler.py

# Commande de démarrage
CMD ["python", "handler.py"]
