# Dockerfile pour RunPod Worker - pyannote.audio 3.3.2
# Image CUDA 12.4 (compatible pyannote 3.3.2)
FROM nvidia/cuda:12.4.0-runtime-ubuntu22.04

# Force l'affichage immédiat des logs
ENV PYTHONUNBUFFERED=1
ENV DEBIAN_FRONTEND=noninteractive

# Installer Python 3.11 et dépendances système de base pour l'audio
RUN apt-get update && apt-get install -y \
    python3.11 \
    python3.11-venv \
    python3-pip \
    ffmpeg \
    libsndfile1 \
    git \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.11 /usr/bin/python \
    && ln -sf /usr/bin/python3.11 /usr/bin/python3

# Créer le répertoire de travail
WORKDIR /app

# Copier requirements.txt
COPY runpod_worker/requirements.txt ./requirements.txt

# 1) Pip + torch/torchaudio depuis l'index PyTorch cu124
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir torch torchaudio --index-url https://download.pytorch.org/whl/cu124

# 2) Reste des dépendances (pyannote voit torch/torchaudio déjà installés)
RUN pip install --no-cache-dir -r requirements.txt

# 3) Vérification (séparée pour diagnostiquer si échec)
RUN python -c "import torch; print(f'Torch: {torch.__version__}')" && \
    python -c "import pyannote.audio; print('Pyannote OK')"

# Copier le handler
COPY runpod_worker/handler.py ./handler.py

# HF_TOKEN doit être fourni comme variable d'environnement au runtime
# Les modèles pyannote (~100 MB) seront téléchargés au premier appel
CMD ["python", "handler.py"]
