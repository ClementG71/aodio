# Dockerfile pour RunPod Worker - pyannote.audio 4.0.2
# PyTorch 2.5.0 avec CUDA 12.1 - versions stables recommandées par pyannote
FROM pytorch/pytorch:2.5.0-cuda12.1-cudnn9-runtime

# Force l'affichage immédiat des logs (critique pour le debug)
ENV PYTHONUNBUFFERED=1

# Installer les dépendances système (ffmpeg requis par torchcodec)
RUN apt-get update && apt-get install -y \
    ffmpeg \
    libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

# Créer le répertoire de travail
WORKDIR /app

# Copier requirements.txt d'abord (pour maximiser le cache)
COPY runpod_worker/requirements.txt ./requirements.txt

# Installation en 2 étapes pour garantir les versions stables
# 1. Installer torch/torchvision/torchaudio depuis l'index CUDA officiel
# 2. Installer le reste des dépendances depuis PyPI
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cu121 \
        torch==2.5.0 torchvision==0.20.0 torchaudio==2.5.0 && \
    pip install --no-cache-dir -r requirements.txt

# Copier le handler en dernier (change le plus souvent)
COPY runpod_worker/handler.py ./handler.py

# Commande de démarrage
CMD ["python", "handler.py"]
