# Dockerfile pour RunPod Worker - pyannote.audio 3.3.2
# Image CUDA de base SANS PyTorch pré-installé
# Pyannote 3.x utilise torch/torchaudio modernes
FROM nvidia/cuda:12.4.0-runtime-ubuntu22.04

# Force l'affichage immédiat des logs
ENV PYTHONUNBUFFERED=1
ENV DEBIAN_FRONTEND=noninteractive

# Token Hugging Face pour pré-télécharger le modèle au build
ARG HF_TOKEN
ENV HF_TOKEN=${HF_TOKEN}

# Installer Python 3.11 et dépendances système de base pour l'audio
RUN apt-get update && apt-get install -y \
    python3.11 \
    python3.11-venv \
    python3-pip \
    ffmpeg \
    libsndfile1 \
    git \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.11 /usr/bin/python \
    && ln -sf /usr/bin/python3.11 /usr/bin/python3

# Créer le répertoire de travail
WORKDIR /app

# Copier requirements.txt
COPY runpod_worker/requirements.txt ./requirements.txt

# Installer les dépendances Python (pyannote 3.3.2 + torch 2.x)
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt && \
    python -c "import torch; print(f'Torch: {torch.__version__}'); import pyannote.audio; print('Pyannote OK')"

# Pré-télécharger le modèle de diarisation pour éviter les timeouts au runtime
RUN python -c "\
from huggingface_hub import login; \
import os; \
token = os.environ.get('HF_TOKEN'); \
print(f'Using HF_TOKEN: {\"set\" if token else \"missing\"}'); \
login(token=token) if token else None; \
from pyannote.audio import Pipeline; \
Pipeline.from_pretrained('pyannote/speaker-diarization-3.1', token=token) if token else None"

# Copier le handler
COPY runpod_worker/handler.py ./handler.py

# Commande de démarrage
CMD [\"python\", \"handler.py\"]
